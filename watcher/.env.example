# Copy to .env on the deployment host. Never commit the filled-in file.
TG_TOKEN=
TG_ADMIN_ID=
TG_MODE=polling
TG_API_URL=https://api.telegram.org
TG_API_FILE_URL=
# Public Telegram Bot API has a lower download limit; set this for your API.
TG_MAX_DOCUMENT_BYTES=20971520
TG_WEBHOOK_URL=
TG_WEBHOOK_SECRET=
VALHEIM_PROJECT_DIR=/srv/valheim
VALHEIM_CONTAINER=valheim-server
VALHEIM_HOOK_SECRET=
YM_TOKEN=
YM_CHAT_IDS=
YM_LOGINS=
